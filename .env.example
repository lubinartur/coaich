# VITE_ANTHROPIC_API_KEY: Optional for local Vite dev proxy requests from the browser.
# Use this for local development when `/api/anthropic` is proxied by Vite directly to Anthropic.
VITE_ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# ANTHROPIC_API_KEY: Required for Vercel serverless functions in production.
# Set this in Vercel Environment Variables so `api/anthropic.ts` can call Anthropic server-side.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
